+def m5(C, R, H):  # prim_from's 4 values + any-hit ratio of pooled counts
+    h = H.sum(0)
+    return np.append(M1.prim_from(C.sum(0), R.sum(0)), h[0] / h[1] if h[1] else np.nan)
