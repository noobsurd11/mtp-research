@@ -0,0 +1,213 @@
+"""cv02 queue script (bench/q/cv02/cq.sh): further readouts per job (10th jobs.txt field) and the QC queue-code dir
+(c3swad, patch harness/c3swad/cq_c3swad.patch).
+
+As tests/test_bench_cq_cv5v3.py: cq.sh is run for real in a sandbox up to the end of arming (it renders
+Q/jobs_rendered.txt and stops at the gpumem-logger check), with a stub python for the card calls. The only edit to the
+script is the hardcoded '. /tmp/noob_el/env.sh' line.
+Checks: a line without the 10th field renders exactly the pre-patch commands; a line with readouts gets one more dump
+line per key (--run-id <name>.<key> --weights-key <key> --bench-run dump_<name>.<key>) and nothing else changes; bad
+readout fields are refused before any start; with QC set, the cv02 card variant and cvcard.py come from QC and QC's
+CODE.md5 must check.
+"""
+import hashlib
+import os
+import shutil
+import stat
+import subprocess
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+CQ = REPO / "bench" / "q" / "cv02" / "cq.sh"
+LIB = REPO / "bench" / "q" / "bench_lib.sh"
+ENV_LINE = ". /tmp/noob_el/env.sh"
+DEPLOY = "0" * 40
+CARD = "bench/methods/swad_const_pf_v11.yaml"
+
+STUB_P = r"""#!/bin/bash
+# stub python for the cq.sh sandbox: bench.cards validate / opts, yget (-c) incl. weights_key and readouts, cvcard.py
+# (no weights; its arguments are appended to $STUBLOG).
+if [ "$1" = -m ]; then
+  case "$3" in validate) exit 0;;
+    opts) shift 4; s=""; n=""; r=""; while [ $# -gt 0 ]; do case "$1" in --seed) s=$2;; --run-name) n=$2;; --data-root) r=$2;; esac; shift 2; done
+          echo "training.seed=$s run_name=$n data.root=$r"; exit 0;; esac; exit 9
+elif [ "$1" = -c ]; then
+  case "$4" in memory.gate_mib) echo 9000;; config) echo configs/base.yaml;; name) echo stub_method;;
+    weights_key) echo swad_bn;;
+    readouts) echo "[{'name': 'raw', 'weights_key': 'model'}, {'name': 'swad', 'weights_key': 'swad'}, {'name': 'swad_bn', 'weights_key': 'swad_bn'}, {'name': 'ema_9998', 'weights_key': 'ema_9998'}]";;
+    *) exit 9;; esac; exit 0
+else echo "$*" >> "$STUBLOG"; exit 0; fi
+"""
+
+
+def _md5(p: Path) -> str:
+    return hashlib.md5(p.read_bytes()).hexdigest()
+
+
+def _md5file(base: Path, rels: list[str], out: Path) -> None:
+    out.write_text("".join(f"{_md5(base / r)}  {r}\n" for r in rels))
+
+
+def _root(parent: Path, name: str) -> str:
+    r = parent / name
+    (r / "splits").mkdir(parents=True)
+    for f, n in (("train.txt", 3), ("val.txt", 2), ("test.txt", 2)):
+        (r / "splits" / f).write_text("".join(f"{name}_c{i}\n" for i in range(n)))
+    _md5file(r, ["splits/train.txt", "splits/val.txt", "splits/test.txt"], r / "SPLITS.md5")
+    _md5file(r, ["splits/train.txt"], r / "DATA_MANIFEST.md5")
+    return f"{name}/SPLITS.md5"
+
+
+def _code(tmp: Path, name: str) -> Path:
+    B = tmp / name
+    (B / "bench" / "q" / "cv02").mkdir(parents=True)
+    shutil.copy(LIB, B / "bench" / "q" / "bench_lib.sh")
+    (B / "bench" / "q" / "cv02" / "cvcard.py").write_text("# stub\n")
+    (B / "REVISION").write_text(DEPLOY + "\n")
+    _md5file(B, ["bench/q/bench_lib.sh"], B / "CODE.md5")
+    return B
+
+
+def _sandbox(tmp: Path) -> dict:
+    assert CQ.read_text().count(ENV_LINE) == 1
+    B = _code(tmp, "B")
+    cq = tmp / "cq.sh"
+    cq.write_text(CQ.read_text().replace(ENV_LINE, ":"))
+    P = tmp / "python"
+    P.write_text(STUB_P)
+    P.chmod(P.stat().st_mode | stat.S_IXUSR)
+    D = tmp / "data"
+    (D / "meta").mkdir(parents=True)
+    (D / "meta" / "forbidden_v1.txt").write_text("x\n")
+    _md5file(D, ["meta/forbidden_v1.txt"], D / "DEPLOY.md5")
+    (D / "roots").mkdir()
+    lines = [_root(D / "roots", "cv5v2_v11_f0"), _root(D / "roots", "cv5v2_v1_f1")]
+    _md5file(D / "roots", lines, D / "roots" / "ROOTS_cv5v2_v11.md5")
+    _md5file(D / "roots", lines[1:], D / "roots" / "ROOTS_cv5v2_v1.md5")
+    V = tmp / "data_v3"
+    (V / "roots").mkdir(parents=True)
+    vl = [_root(V / "roots", "cv5v3_v11_f2")]
+    _md5file(V / "roots", vl, V / "roots" / "ROOTS_cv5v3_v11.md5")
+    return {"B": B, "cq": cq, "P": P, "D": D, "V": V, "log": tmp / "stub.log"}
+
+
+def _run(s: dict, tmp: Path, jobs: list[str], qc: Path | None = None):
+    Q = tmp / f"q{len(list(tmp.glob('q*')))}"
+    Q.mkdir()
+    (Q / "jobs.txt").write_text("".join(j + "\n" for j in jobs))
+    (Q / "LPG").write_text("1\n")
+    env = dict(os.environ, B=str(s["B"]), Q=str(Q), JOBS_MD5=_md5(Q / "jobs.txt"), DEPLOY=DEPLOY,
+               DATA_MD5=_md5(s["D"] / "DEPLOY.md5"), DATA=str(s["D"]), DATA_V3=str(s["V"]), P=str(s["P"]),
+               STUBLOG=str(s["log"]))
+    env.pop("QC", None)
+    if qc is not None:
+        env["QC"] = str(qc)
+    r = subprocess.run(["bash", str(s["cq"])], env=env, capture_output=True, text=True, timeout=60)
+    log = (Q / "launch.log").read_text()
+    rend = (Q / "jobs_rendered.txt").read_text() if (Q / "jobs_rendered.txt").exists() else None
+    return r.returncode, log, rend
+
+
+def _job(name, root, fold, logp=0, extra="", ro=None):
+    return f"{name}|{CARD}|5|{root}|{fold}|11000|5262|{logp}|{extra}" + ("" if ro is None else f"|{ro}")
+
+
+def _want(s, name, root, set_name, logp):
+    B, D, P = s["B"], s["D"], s["P"]
+    d = (f"dump_{name}|{P} -u scripts/bench_infer.py --run {B}/experiments/{name} --set {set_name} --dumps {B}/dumps "
+         f"--method stub_method --card {CARD} --run-id {name} --device cuda --precision fp32 --threads 4 --workers 4 "
+         f"--batch 8{' --logp' if logp else ''} --forbidden {D}/meta/forbidden_v1.txt --bench-run dump_{name}")
+    t = f"{name}|{P} -u scripts/train.py --config configs/base.yaml --opts training.seed=5 run_name={name} data.root={root}"
+    return d, t
+
+
+needs_bash = pytest.mark.skipif(shutil.which("bash") is None, reason="needs bash")
+
+
+@needs_bash
+def test_line_without_the_field_renders_the_prepatch_commands(tmp_path):
+    s = _sandbox(tmp_path)
+    root = f"{s['V']}/roots/cv5v3_v11_f2"
+    rc, log, rend = _run(s, tmp_path, [_job("c3_x", root, 2, logp=1)])
+    assert rc == 1 and "gpumem logger (cq_gpumem.sh) not running; not starting" in log.splitlines()[-1]
+    d, t = _want(s, "c3_x", root, "cv5v3_f2", 1)
+    assert rend == t + "\n" + d + "\n"      # sort order: "c3_x|" before "dump_c3_x|"
+    assert "queue code QC" not in log
+
+
+@needs_bash
+def test_readout_adds_one_dump_line_and_changes_nothing_else(tmp_path):
+    s = _sandbox(tmp_path)
+    root = f"{s['V']}/roots/cv5v3_v11_f2"
+    rc, log, rend = _run(s, tmp_path, [_job("c3s_y", root, 2, ro="swad"), _job("c3_x", root, 2, logp=1)])
+    assert rc == 1 and "gpumem logger" in log.splitlines()[-1]
+    dx, tx = _want(s, "c3_x", root, "cv5v3_f2", 1)
+    dy, ty = _want(s, "c3s_y", root, "cv5v3_f2", 0)
+    d2 = dy.replace("dump_c3s_y|", "dump_c3s_y.swad|", 1).replace(" --run-id c3s_y ", " --run-id c3s_y.swad --weights-key swad ")
+    d2 = d2[: -len("--bench-run dump_c3s_y")] + "--bench-run dump_c3s_y.swad"
+    assert sorted(rend.splitlines()) == sorted([dx, tx, dy, ty, d2])
+    assert d2.count("--weights-key") == 1 and "--weights-key" not in dx + tx + dy + ty
+
+
+@needs_bash
+def test_two_readouts(tmp_path):
+    s = _sandbox(tmp_path)
+    root = f"{s['V']}/roots/cv5v3_v11_f2"
+    rc, log, rend = _run(s, tmp_path, [_job("c3s_y", root, 2, ro="swad,ema_9998")])
+    assert rc == 1 and "gpumem logger" in log.splitlines()[-1]
+    names = sorted(ln.split("|", 1)[0] for ln in rend.splitlines())
+    assert names == ["c3s_y", "dump_c3s_y", "dump_c3s_y.ema_9998", "dump_c3s_y.swad"]
+
+
+@needs_bash
+@pytest.mark.parametrize("ro,why", [
+    ("swad_bn", "is the card's weights_key or is listed twice"),
+    ("swad,swad", "is the card's weights_key or is listed twice"),
+    ("raw_bn", "is not in the card's readouts"),
+    ("Swad", "bad readout key"),
+    ("swad;x", "bad readout key"),
+    ("swad|x", "bad readout key"),
+    (",", "names no key"),
+])
+def test_bad_readout_fields_are_refused(tmp_path, ro, why):
+    s = _sandbox(tmp_path)
+    rc, log, rend = _run(s, tmp_path, [_job("c3s_y", f"{s['V']}/roots/cv5v3_v11_f2", 2, ro=ro)])
+    assert rc == 1 and rend is None and why in log and log.rstrip().endswith("not starting")
+
+
+@needs_bash
+def test_readouts_are_refused_for_smoke_jobs(tmp_path):
+    s = _sandbox(tmp_path)
+    rc, log, rend = _run(s, tmp_path, [_job("smoke_y", f"{s['V']}/roots/cv5v3_v11_f2", 2, extra="--exit_after_step 50", ro="swad")])
+    assert rc == 1 and rend is None and "readouts not allowed with extra" in log
+
+
+@needs_bash
+def test_qc_supplies_cvcard_and_the_cv02_variant(tmp_path):
+    s = _sandbox(tmp_path)
+    QC = _code(tmp_path, "QC")
+    root = f"{s['V']}/roots/cv5v3_v11_f2"
+    rc, log, rend = _run(s, tmp_path, [_job("c3s_y", root, 2, ro="swad")], qc=QC)
+    assert rc == 1 and "gpumem logger" in log.splitlines()[-1] and rend is not None
+    calls = s["log"].read_text().splitlines()
+    assert calls == [f"{QC}/bench/q/cv02/cvcard.py {CARD} {QC}/bench/methods_cv02/swad_const_pf_v11.yaml"]
+    assert f"--run {s['B']}/experiments/c3s_y " in rend and str(QC) not in rend     # training and dumps stay in B
+
+
+@needs_bash
+def test_without_qc_the_variant_and_cvcard_come_from_b(tmp_path):
+    s = _sandbox(tmp_path)
+    rc, log, rend = _run(s, tmp_path, [_job("c3s_y", f"{s['V']}/roots/cv5v3_v11_f2", 2, ro="swad")])
+    assert rc == 1 and rend is not None
+    B = s["B"]
+    assert s["log"].read_text().splitlines() == [f"{B}/bench/q/cv02/cvcard.py {CARD} {B}/bench/methods_cv02/swad_const_pf_v11.yaml"]
+
+
+@needs_bash
+def test_qc_code_md5_must_check(tmp_path):
+    s = _sandbox(tmp_path)
+    QC = _code(tmp_path, "QC")
+    (QC / "bench" / "q" / "bench_lib.sh").write_text("tampered\n")
+    rc, log, rend = _run(s, tmp_path, [_job("c3s_y", f"{s['V']}/roots/cv5v3_v11_f2", 2, ro="swad")], qc=QC)
+    assert rc == 1 and rend is None and "deploy check FAIL" in log and "not starting" in log
