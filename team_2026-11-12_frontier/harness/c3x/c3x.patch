diff --git a/tests/test_bench_c3x_card.py b/tests/test_bench_c3x_card.py
new file mode 100644
index 0000000..5a774a6
--- /dev/null
+++ b/tests/test_bench_c3x_card.py
@@ -0,0 +1,122 @@
+"""c3x card hrnet_w18_unetpp_swad_const_pf_v11 (lead's rulings C2 and Q3, 17 Nov 2026): the card is hrnet_w18_unetpp_pf_v11
+with exactly the changes that swad_const_pf_v11 makes to house_r34_unetpp_pf_v11. Mechanical proofs, PyYAML only (no torch):
+  1. card files: the non-comment lines that the new card adds to or removes from the HRNet card are the lines that the swad
+     card adds to or removes from the PF card, except the five descriptive keys name, papers, memory, diff_ref, notes (each
+     checked by value in test 2); the HRNet card's comment header is kept verbatim;
+  2. parsed cards: opts = HRNet opts + the 8 opts the swad card appends to the PF opts; weights_key and readouts = the swad
+     card's; every other functional key = the HRNet card's;
+  3. rendered config (what train.py writes as config_used.yaml): new against HRNet differs in the same keys, with the same
+     values, as swad against PF; for a real job (same seed and cv5v3 root) only run_name and those 8 keys differ.
+Also: the opts the queue renders, the cv02 variant (weights path only; cvcard.py passes), the queue's readout field 'swad'.
+"""
+import difflib
+import subprocess
+import sys
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO))
+from bench.cards import config_diff, expected_config, load_card, run_opts  # noqa: E402
+
+M = REPO / "bench" / "methods"
+NEW, HRNET, SWAD, PF = (M / f"{n}.yaml" for n in ("hrnet_w18_unetpp_swad_const_pf_v11", "hrnet_w18_unetpp_pf_v11",
+                                                 "swad_const_pf_v11", "house_r34_unetpp_pf_v11"))
+DESCRIPTIVE = ("name:", "papers:", "  peak_mib:", "  gate_mib:", "  source:", "diff_ref:", "notes:")
+EIGHT = [("training.lr_scheduler", "constant"), ("training.weight_avg.swad.mode", "uniform"),
+         ("training.weight_avg.swad.start", 10000), ("training.weight_avg.swad.end", 20000),
+         ("training.weight_avg.ema_9998.mode", "ema"), ("training.weight_avg.ema_9998.decay", 0.9998),
+         ("training.bn_recal", "true"), ("training.enc_probe_every", 2000)]
+SWAD_KEYS = sorted(k for k, _ in EIGHT)
+ROOT_F2 = "/tmp/noob_el/bench_data_v3b/roots/cv5v3_v11_f2"
+
+
+def changed_lines(a: Path, b: Path, descriptive: bool = False) -> list[str]:
+    """+/- lines of the diff a -> b without comment lines; the descriptive keys only (True) or everything else (False)."""
+    d = difflib.unified_diff(a.read_text().splitlines(), b.read_text().splitlines(), lineterm="", n=0)
+    out = [l for l in d if l[:1] in "+-" and l[:3] not in ("+++", "---") and not l[1:].startswith("#")]
+    return [l for l in out if l[1:].startswith(DESCRIPTIVE) == descriptive]
+
+
+def test_file_diff_equals_swad_diff():
+    want = changed_lines(PF, SWAD)
+    assert changed_lines(HRNET, NEW) == want
+    assert want == [f"+  - {k}={v}" for k, v in EIGHT] + ["-weights_key: model", "+weights_key: swad_bn", "+readouts:"] + [
+        f"+  - {{name: {n}, weights_key: {k}}}" for n, k in (("raw", "model"), ("raw_bn", "raw_bn"), ("swad", "swad"),
+                                                            ("swad_bn", "swad_bn"), ("ema_9998", "ema_9998"),
+                                                            ("ema_9998_bn", "ema_9998_bn"))]
+    # the lines set aside are the same descriptive keys in both diffs (their values: test 2)
+    keys = lambda ls: [l[1:].split(":")[0] for l in ls]  # noqa: E731
+    assert keys(changed_lines(HRNET, NEW, True)) == keys(changed_lines(PF, SWAD, True)) == [
+        "name", "name", "papers", "papers", "  peak_mib", "  gate_mib", "  source", "  peak_mib", "  gate_mib", "  source",
+        "diff_ref", "notes", "diff_ref", "notes"]
+
+
+def test_hrnet_header_kept():
+    hr = [l for l in HRNET.read_text().splitlines() if l.startswith("#")]
+    new = NEW.read_text().splitlines()
+    i = new.index(hr[0])
+    assert new[i:i + len(hr)] == hr and len(hr) == 17
+
+
+def test_parsed_card_equals_hrnet_plus_swad_changes():
+    new, hr, sw, pf = (load_card(p) for p in (NEW, HRNET, SWAD, PF))
+    n = len(pf["opts"])
+    assert sw["opts"][:n] == pf["opts"]                       # the swad card only appends to the PF opts
+    added = sw["opts"][n:]
+    assert added == [f"{k}={v}" for k, v in EIGHT] and new["opts"] == hr["opts"] + added
+    assert new["weights_key"] == sw["weights_key"] == "swad_bn" and new["readouts"] == sw["readouts"]
+    for k in ("version", "family", "kind", "config", "weights", "decision_rule", "external"):
+        assert new[k] == hr[k], k
+    assert set(new) == set(sw) and set(new) - set(hr) == {"readouts"}
+    # the five descriptive keys
+    assert new["name"] == NEW.stem and new["diff_ref"] == hr["name"] and sw["diff_ref"] == pf["name"]
+    assert new["papers"] == hr["papers"] + sw["papers"] and pf["papers"] == []
+    assert new["memory"]["peak_mib"] is None and new["memory"]["gate_mib"] == sw["memory"]["gate_mib"] == 11000
+    assert new["memory"]["gate_mib"] >= hr["memory"]["peak_mib"] + 2048
+    assert "readouts: model (constant-lr raw), raw_bn, swad, swad_bn (primary)" in new["notes"]
+
+
+def test_rendered_config_diff_equals_swad_diff():
+    new, hr, sw, pf = (load_card(p) for p in (NEW, HRNET, SWAD, PF))
+    a = config_diff(expected_config(hr, 0, "x", "R"), expected_config(new, 0, "x", "R"))
+    b = config_diff(expected_config(pf, 0, "x", "R"), expected_config(sw, 0, "x", "R"))
+    assert a == b and [x.split(":")[0] for x in a] == SWAD_KEYS
+    assert "training.lr_scheduler: 'cosine' -> 'constant'" in a and "training.weight_avg.swad.start: '<absent>' -> 10000" in a
+    assert "training.weight_avg.swad.end: '<absent>' -> 20000" in a and "training.bn_recal: '<absent>' -> True" in a
+    # a real job of each arm on the same seed and root: only the run name and the 8 keys differ
+    d = config_diff(expected_config(hr, 7, "c3h_hrnet_w18_unetpp_pf_f2_s7", ROOT_F2),
+                    expected_config(new, 7, "c3x_hrnet_swad_v11_f2_s7", ROOT_F2))
+    assert sorted(x.split(":")[0] for x in d) == sorted(SWAD_KEYS + ["run_name"])
+    cfg = expected_config(new, 7, "c3x_hrnet_swad_v11_f2_s7", ROOT_F2)
+    assert cfg["model"]["encoder_name"] == "tu-hrnet_w18" and cfg["model"]["decoder"] == "unetplusplus"
+    assert cfg["training"]["total_steps"] == 20000 and cfg["training"]["labeled_batch_size"] == 8
+    assert cfg["training"]["weight_avg"] == {"swad": {"mode": "uniform", "start": 10000, "end": 20000},
+                                             "ema_9998": {"mode": "ema", "decay": 0.9998}}
+
+
+def test_run_opts_are_the_hrnet_opts_plus_eight():
+    new, hr = load_card(NEW), load_card(HRNET)
+    a = run_opts(new, 5, "n", "/r"); b = run_opts(hr, 5, "n", "/r")
+    assert len(a) == len(b) + 8 and a[:len(b) - 2] == b[:-2] and a[-2:] == b[-2:]
+    assert a[len(b) - 2:-2] == [f"{k}={v}" for k, v in EIGHT]
+
+
+def test_queue_readout_field():
+    """cq.sh accepts the 10th field 'swad' only if it is a readouts key and not the weights_key (cq.sh, arming)."""
+    new = load_card(NEW)
+    assert new["weights_key"] != "swad" and "'weights_key': 'swad'" in str(new["readouts"])
+
+
+def test_cv02_variant():
+    cv = REPO / "bench" / "methods_cv02" / NEW.name
+    a, b = NEW.read_text().splitlines(), cv.read_text().splitlines()
+    d = [l for l in difflib.unified_diff(a, b, lineterm="", n=0) if l[:1] in "+-" and l[:3] not in ("+++", "---")]
+    assert len(d) == 2 and d[0].startswith("-  - path: /home/noob/.cache/huggingface/hub/") \
+        and d[1].startswith("+  - path: /tmp/noob_el/cache/hf/hub/"), d
