  LIST=""
  for n in $(cut -d'|' -f1 $IO/jobs_dump.txt); do
    m=$(awk '{print $4}' $RD2/.ok/$n 2>/dev/null)
    [ -n "$m" ] && [ "$(md5sum < $RD2/$n/runs/$n/RUN.md5 | cut -c1-32)" = "$m" ] || no "$n: relayed RUN.md5 missing or not the .ok md5"
    (cd $RD2/$n && md5sum -c --quiet runs/$n/RUN.md5 > /dev/null 2>&1) || no "$n: gaint md5sum -c of the relayed copy failed"
    k=$(grep -cE "  dumps/elbench1/[A-Za-z0-9_]+/$n/" $RD2/$n/runs/$n/RUN.md5)
    [ "$k" -gt 0 ] && [ "$k" = "$(grep -c . $RD2/$n/runs/$n/RUN.md5)" ] || no "$n: RUN.md5 lists other files than its one dump dir"
    LIST="$LIST$n $m $k
"
  done
  echo "relayed copies verified on gaint: $(printf '%s' "$LIST" | grep -c .) of 30"
  SCR="B=$KB; n0=0; while read n m k; do f=\$B/runs/\$n/RUN.md5
  [ -f \$f ] && [ \"\$(md5sum < \$f | cut -c1-32)\" = \$m ] || { echo \"SKIP RUN.md5 \$n\"; continue; }
  (cd \$B && md5sum -c --quiet runs/\$n/RUN.md5 > /dev/null 2>&1) || { echo \"SKIP md5sum -c \$n\"; continue; }
  d=\$(ls -d \$B/dumps/elbench1/*/\$n 2>/dev/null); [ -n \"\$d\" ] && [ \"\$(echo \"\$d\" | wc -l)\" = 1 ] || { echo \"SKIP nodir \$n\"; continue; }
  [ \"\$(find \"\$d\" -type f | wc -l)\" = \$k ] || { echo \"SKIP count \$n\"; continue; }
  rm -rf -- \"\$d\" && n0=\$((n0+1)) && echo \"\$(date -u +%FT%T) removed \$d (\$k files = the verified relayed copy, RUN.md5 \$m)\" >> /tmp/noob_el/removed_relayed_dumps_t3b.log
  done; echo REMOVED_DUMPS \$n0"
  if [ $DRY = 1 ]; then echo "DRY, not run on cv02: the 30 dump dirs (each after the md5 checks), then rm -rf $DS and $DT"; exit 0; fi
  o=$(printf '%s' "$LIST" | ssh -a -o BatchMode=yes -o ConnectTimeout=20 $C "bash -c '$SCR'") || no "ssh failed"
  echo "$o" | tail -5
  echo "$o" | grep -qx "REMOVED_DUMPS 30" || no "not every sealed dump dir was removed from $KB/dumps (see above; nothing else was touched)"
  Wr "cd $DS && [ \"\$(find . -type f | wc -l)\" = 108 ] && cd /tmp && chmod -R u+w $DS && rm -rf $DS && echo REMOVED $DS"
  Wr "for q in $Q1 $Q2; do p=\$(cat \$q/queue.pid 2>/dev/null); [ -n \"\$p\" ] && kill -0 \$p 2>/dev/null && { echo \"queue \$q alive\"; exit 1; }; done; cd $DT && md5sum -c --quiet MANIFEST.md5 > /dev/null 2>&1 && cd /tmp && chmod -R u+w $DT && rm -rf $DT && echo REMOVED $DT"
  o=$(R "ls -d $DS $DT 2>/dev/null | wc -l"); [ "$o" = 0 ] || no "DS or DT still on cv02"
  say "removed the 30 sealed dump dirs from $KB/dumps (each = its verified relayed copy in $RD2), DS (E1 images) and DT (E1 images, E1 training labels, roots) from cv02";;
*) no "unknown step";;
esac
