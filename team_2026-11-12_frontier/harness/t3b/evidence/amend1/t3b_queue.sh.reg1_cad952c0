#!/bin/bash
# T3b queues on cv02 (T3B_RULE.md section 10; LAUNCH_REQUEST_t3b.md section 6). Run by the LEAD on gaint AFTER the review, the
# registration (t3b_register.sh; ledger row #9 written) and the deploy of K. Pattern: harness/final/opening/opening_queue.sh.
# Two NEW queues, one after the other (never two of ours that can train):
#   t3b      Q1 = /tmp/noob_el/bench_q/t3b: the 33 trainings of IO/jobs_train.txt on the T3b roots (DT), open mode, no dump in
#            the chain (in-sample monitor); LPG 1 (one training of ours per GPU), MAXC = the GPUs free at arm time (or MAXC
#            env, lower), SHARE_TRAIN 20480 (the user's floor, as fin / fin2), no SHARE_DUMP, GAPSEC >= 30.
#   t3bopen  Q2 = /tmp/noob_el/bench_q/t3bopen: the 30 sealed dump-only lines of IO/jobs_dump.txt (Q2/SEALED: e1t3b_f0..4 at
#            opening e1_open9_t3b + the staged images' MANIFEST md5), placed and armed only after t3b's ALL DONE with 33
#            'trained rc=0'; strict lanes (no SHARE file), LPG 1.
# One step per call, in this order; each refuses rather than guess, and prints what it did:
#   build   gaint: K's scripts/bench_make_t3b_roots.py (REPO_K at K, clean) decodes the E1 masks and ignore maps (the files of
#           reg/e1_files.md5 only) into IO/data (the 11 roots, pool files, E1 training labels), then --check; IO/BUILD.txt.
#   check   cv02 READ ONLY: KB = deploy of K (REVISION, CODE.md5, pins; its CODE.md5 differs from F2B's only in K's paths);
#           bench_data DEPLOY.md5; DT / DS / Q1 / Q2 absent or as staged; job names unused on cv02 and in the relay dirs.
#   stage   cv02 WRITE: DT = /tmp/noob_el/bench_data_t3b <- IO/data and DS = /tmp/noob_el/bench_data_sealed <- IO/stage (tar
#           streams); md5sum -c of MANIFEST.md5 / ROOTS_t3b.md5, the link list = LINKS.tsv, DS without any mask dir; read-only.
#   render  cv02 WRITE (scratch queue dir): render-only run of KB's cq.sh on jobs_train.txt; t3b_rendercmp.py --kind train 0 FAIL.
#   place   cv02 WRITE: Q1 with jobs_train.txt (read-only), LPG 1, SHARE_TRAIN 20480, MAXC (rewritten at arm). Not armed.
#   guard   cv02 WRITE + START: disk guard 8 (diskguard8.sh; HOLD in t3b / t3bopen below 20 GB free; tmux bench_diskguard8).
#   arm     cv02 START: pre-checks (render passed, Q1 placed and unused, check again, DT staged, guard 8 running, free >= 55
#           GB), MAXC = GPUs with < 4096 MiB used now (or MAXC env if lower), then KB's cq_setup.sh (session bench_q_t3b).
#   status  cv02 READ ONLY (both queues).
#   render2 cv02 WRITE (scratch): only after t3b's ALL DONE with 33 'trained rc=0' and 33 RUN.md5; render-only of KB's cq.sh on
#           jobs_dump.txt with the SEALED file; t3b_rendercmp.py --kind dump 0 FAIL.
#   place2  cv02 WRITE: Q2 with jobs_dump.txt and SEALED (read-only), LPG 1, MAXC, no SHARE file.
#   arm2    cv02 START: pre-checks (render2 passed, Q2 placed and unused, t3b ended, DS staged, guard 8 running, free >= 25 GB),
#           then cq_setup.sh (session bench_q_t3bopen).
#   unstage cv02 WRITE, after the registered read (its run.log 'T3B READ ALL DONE'): (1) the 30 sealed dump dirs in KB/dumps,
#           each only after gaint's md5sum -c of its relayed copy (RD2) and cv02's md5sum -c of every listed file against the
#           same RUN.md5 (pattern of opening_queue.sh unstage); (2) DS (only if it holds exactly its MANIFEST's files); (3) DT
#           (only if md5sum -c of its MANIFEST passes and both queues have ended). No E1 image, mask or prediction then stays
#           on cv02; runs/<job>/RUN.md5 and the 33 run dirs (models) stay.
#   gate    READ ONLY (cv02 + gaint): the condition of render2 / place2 / arm2 alone (q1_done, below); prints it or refuses.
#   repair steps (review round 1 N1; T3B_RULE.md section 10), for trainings that ended rc != 0, before t3bopen:
#   repair_register  gaint: RN (1..9), NAMES_R (failed training names), KIND (fresh | resume) -> IO/repair<RN>/jobs.txt (the
#           same lines; resume adds '--resume', cq.sh's F2 resume kind) and REPAIR.txt / REPAIR.md5; prints the ledger
#           amendment line. A repair counts only once e1_openings.md holds its REPAIR.txt md5 (registered repair).
#   repair_aside cv02 WRITE: for a registered repair: fresh = experiments/<n> and <n>.stdout renamed to *.failed<RN> (so the
#           same line runs from step 0 in a fresh dir); resume = only <n>.stdout renamed (latest.pth must exist).
#   render_r / place_r / arm_r: as render / place / arm for the repair queue bench_q/t3brep<RN> (t3b_rendercmp.py --kind
#           repair; LPG 1, SHARE_TRAIN 20480, MAXC); arm_r only when t3b and every other repair queue have ended.
# q1_done (gate, render2, place2, arm2): every training name has 'trained <n> rc=0' in t3b's launch.log or in the launch.log
#   of a registered repair queue that lists it, and KB/runs/<n>/RUN.md5; t3b and every registered repair queue ended (ALL
#   DONE, queue process gone); no unregistered bench_q/t3brep* dir; RD1/relay.log 'RELAY ALL DONE: 33 of 33' (round 1 B1);
#   t3b_deploy_s5..7: RD1/.ok, gaint md5sum -c of the relayed RUN.md5, latest.pth relayed and = LATEST.md5 ('DEPLOY LATEST
#   DONE: 3 of 3'; N10).
# Round 1: B2 every step refuses unless this script, t3b_rendercmp.py, diskguard8.sh and t3b_label_precheck.py are the
#   md5s of the registration's 'scripts' line; N6 build and stage refuse unless the ledger (e1_openings.md) holds a '| 9 |'
#   row with REG_MD5; N8 build first runs t3b_label_precheck.py (all 106 labels decoded and checked in memory) and only then
#   K's builder, which writes IO/data.
# DRY=1: every cv02 write or start is printed, not run; read-only checks run.
# Env: REG_MD5 (required: the md5 of REGISTERED.txt logged in the ledger), K (full commit, for the cv02 steps), MAXC, GAPSEC
#   (>= 30), RD1 / RD2 (relay dirs; default the NAS dirs bench_relay/t3b and bench_relay/t3bopen, as t3b_relay.sh).
#   Test-only overrides: IO, EXT_DIR, REPO_K, RD1, RD2, READ_OUT, LEDGER. If any is set the script refuses unless TEST_MODE=1;
#   with TEST_MODE=1 IO, EXT_DIR, RD1, RD2, READ_OUT and LEDGER must be set, absolute and resolve under /home/noob/work/bench_int_io, the
#   registration must be a TEST MODE one, and every cv02 step needs `ssh` to be a stub under that dir (checked before any
#   read, hash, mkdir or ssh). A real registration refuses TEST_MODE.
set -u
STEP=${1:?step: build | check | stage | render | place | guard | arm | status | gate | render2 | place2 | arm2 | unstage | repair_register | repair_aside | render_r | place_r | arm_r}
OV=""; for v in IO EXT_DIR REPO_K RD1 RD2 READ_OUT LEDGER; do [ -n "${!v+x}" ] && OV="$OV $v=${!v}"; done
if [ -n "$OV" ] && [ "${TEST_MODE:-0}" != 1 ]; then echo "REFUSED ($STEP): test-only overrides set:$OV (TEST_MODE=1 only for dry runs)"; exit 1; fi
SCR_ROOT=/home/noob/work/bench_int_io
tm_no(){ echo "REFUSED (TEST_MODE guard): $*"; exit 1; }
tm_in(){ local r; case "$1" in /*) ;; *) tm_no "$1 is not an absolute path";; esac; r=$(readlink -m -- "$1"); case "$r/" in "$SCR_ROOT"/*/*) ;; *) tm_no "$1 resolves to $r, outside $SCR_ROOT";; esac; }
if [ "${TEST_MODE:-0}" = 1 ]; then
  for v in IO EXT_DIR RD1 RD2 READ_OUT LEDGER; do [ -n "${!v+x}" ] && [ -n "${!v}" ] || tm_no "$v must be set explicitly to a path under $SCR_ROOT (its default is a production path)"; done
  for p in "$IO" "$EXT_DIR" "$EXT_DIR/stems_eval.txt" "$EXT_DIR/images" "$EXT_DIR/masks" "$EXT_DIR/ignore" "$RD1" "$RD2" "$READ_OUT" "$LEDGER"; do tm_in "$p"; done
  for d in "$IO" "$EXT_DIR" "$RD1" "$RD2"; do [ -d "$d" ] || continue; for l in $(find "$d" -type l 2>/dev/null); do tm_in "$l"; done; done
  case "$STEP" in build|repair_register) ;; *) s=$(command -v ssh); tm_in "${s:-/nonexistent}";; esac
fi
IO=${IO:-/home/noob/work/bench_t3b_io}; EXT_DIR=${EXT_DIR:-/home/noob/work/el_f1/reports/f1/ext117}
REPO_K=${REPO_K:-/home/noob/work/bench_wt_t3b}; READ_OUT=${READ_OUT:-/home/noob/work/bench_reads/t3b_open9}
RD1=${RD1:-/mnt/nas/noob_el_archive/bench_relay/t3b}; RD2=${RD2:-/mnt/nas/noob_el_archive/bench_relay/t3bopen}
LEDGER=${LEDGER:-/home/yugma/mtp/research/team_2026-10-31_next/e1_openings.md}
DRY=${DRY:-0}; K=${K:-}; GAPSEC=${GAPSEC:-30}
KC=cba7fbdf5df1579d6efb1168eb292e637bc9fad6; F2C=9967d59abaab03cef83c1e3014840b2359ef45d7
KB=/tmp/noob_el/bench_${KC:0:7}; F2B=/tmp/noob_el/bench_9967d59; BQ=/tmp/noob_el/bench_q; Q1=$BQ/t3b; Q2=$BQ/t3bopen
DT=/tmp/noob_el/bench_data_t3b; DS=/tmp/noob_el/bench_data_sealed; DATA_MD5=d6063fd83d20e656612540edda702cbe
OPENING=e1_open9_t3b; SHARE_TRAIN=20480; FLOOR_ARM=55; FLOOR_ARM2=25
HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd); ME=$(readlink -f "$0")
GUARD8_MD5=$(md5sum < $HERE/diskguard8.sh | cut -c1-32); [ "$GUARD8_MD5" = 0fe96ad9b0208bf6381f2bc5ee7b60b4 ] || { echo "REFUSED: diskguard8.sh is not the pinned md5"; exit 1; }
[ "$(md5sum < $HERE/t3b_rendercmp.py | cut -c1-32)" = d6eec93f53818d3dbb0151845dac1ef4 ] || { echo "REFUSED: t3b_rendercmp.py is not the pinned md5"; exit 1; }
P=/home/noob/work/el-fault-detection/.venv/bin/python
PINS="227ce66853327e5393e7fa1548235381  bench/q/cv02/cq.sh
9684c116ea35e8748fe861d15fdda8a7  bench/q/cv02/cq_setup.sh
2a5f688160eb100eb0bc9784ffe06e7e  bench/q/cv02/cq_gpumem.sh
f3affc80b21406644cedbc80d6e250ba  bench/q/cv02/cvcard.py
20712dd3af1e6b86720a9633b419de00  bench/q/cv02/slim_ckpt.py
1af2ed69babf72e9d0d0aa789eb71121  bench/q/bench_lib.sh
6dc3a22ae3f419df077d4b511f971dda  scripts/train.py
149e2a633094e94343cb729dbd570557  scripts/bench_infer.py
801ff5228c14476968627bbdbff3253e  bench/tta.py
92ef7db3cbe1fe74fe1823cc71844db1  bench/sets.py
d2d0fe8b67be9a7cf33367eba97295e3  bench/dumpfmt.py
380bab1e117bd1ef5031449f4a90d4ab  bench/cards.py
7fe1004f5d2f0c6aa57c4945377c694d  src/trainers/weight_avg.py
46cda66c647dc2c078758f82112a8136  src/data/benchmark_el.py
5266806b559f74bcf9eae167bb076b95  bench/sets/e1_106_stems.txt
9581b3e2bfe2eb0b784d4eb62469e2a0  bench/sets/e1t3b_f0.txt
c1e8bcf53a38c226fe70c44c624ad713  bench/sets/e1t3b_f1.txt
5067b76be191afddcbf0daeed6947d13  bench/sets/e1t3b_f2.txt
92f8e87da504e18e8b735a2ed50290b6  bench/sets/e1t3b_f3.txt
60aa7c33e0a1a173e529873ab51797d0  bench/sets/e1t3b_f4.txt
98f152de3ea7f8c88e892162e07b4450  bench/methods/hrnet_w18_unetpp_swad_const_pf_v11.yaml
d7b207089f6cfeb484ca9ef96f734786  bench/methods_cv02/hrnet_w18_unetpp_swad_const_pf_v11.yaml"
DW="<bench/cellmeta.py <bench/derived.py <bench/dumpfmt.py <bench/q/cv02/cq.sh <bench/sets.py <scripts/bench_ens_dump.py <scripts/bench_infer.py <scripts/bench_score.py >bench/cellmeta.py >bench/derived.py >bench/dumpfmt.py >bench/public_metrics.py >bench/q/cv02/cq.sh >bench/sets.py >bench/sets/e1_106_stems.txt >bench/sets/e1t3b_f0.txt >bench/sets/e1t3b_f1.txt >bench/sets/e1t3b_f2.txt >bench/sets/e1t3b_f3.txt >bench/sets/e1t3b_f4.txt >bench/sets/masks_v0_pool532.md5 >bench/t3b_labels.py >scripts/bench_ens_dump.py >scripts/bench_infer.py >scripts/bench_make_t3b_roots.py >scripts/bench_open_read.py >scripts/bench_score.py >scripts/bench_t3b_oof.py >tests/test_bench_cq_sealed.py >tests/test_bench_infer_sealed.py >tests/test_bench_opening_read.py >tests/test_bench_public_metrics.py >tests/test_bench_t3b.py "
C=cv02@10.8.1.106
R(){ ssh -n -a -o BatchMode=yes -o ConnectTimeout=20 $C "$1"; }
Wr(){ if [ $DRY = 1 ]; then echo "DRY, not run on cv02: $1"; else ssh -n -a -o BatchMode=yes -o ConnectTimeout=20 $C "$1"; fi; }
no(){ echo "REFUSED ($STEP): $*"; exit 1; }
say(){ echo "[$(date '+%F %T')] $STEP: $*" | tee -a $IO/queue.log; }
# ---- the registration (every step)
REG_MD5=${REG_MD5:?REG_MD5: the md5 of REGISTERED.txt logged in the ledger}
[ -s $IO/REGISTERED.txt ] || no "no registration in $IO (run t3b_register.sh first)"
[ "$(md5sum < $IO/REGISTERED.txt | cut -c1-32)" = "$REG_MD5" ] && [ "$(cat $IO/REGISTERED.md5)" = "$REG_MD5" ] || no "REGISTERED.txt md5 != REG_MD5"
if head -1 $IO/REGISTERED.txt | grep -q '^TEST MODE'; then [ "${TEST_MODE:-0}" = 1 ] || no "the registration is a TEST MODE dry run"
else [ "${TEST_MODE:-0}" != 1 ] || no "TEST_MODE=1 against a real registration"; fi
grep -q "^opening_e1 E1 opening #9 $OPENING " $IO/REGISTERED.txt || no "the registration names another opening"
grep -q "^commits K $KC " $IO/REGISTERED.txt || no "the registration names another K"
JT=$(cat $IO/jobs_train.md5); JD=$(cat $IO/jobs_dump.md5)
[ "$(md5sum < $IO/jobs_train.txt | cut -c1-32)" = "$JT" ] && grep -q "^jobs_train $JT 33 lines" $IO/REGISTERED.txt || no "jobs_train.txt is not the registered list"
[ "$(md5sum < $IO/jobs_dump.txt | cut -c1-32)" = "$JD" ] && grep -q "^jobs_dump $JD 30 lines" $IO/REGISTERED.txt || no "jobs_dump.txt is not the registered list"
SMAN=$(awk '/^stage_manifest /{print $2}' $IO/REGISTERED.txt)
for f in t3b_queue.sh:$ME t3b_rendercmp.py:$HERE/t3b_rendercmp.py diskguard8.sh:$HERE/diskguard8.sh t3b_label_precheck.py:$HERE/t3b_label_precheck.py; do
  grep "^scripts " $IO/REGISTERED.txt | grep -qF " ${f%%:*}=$(md5sum < ${f#*:} | cut -c1-32) " || no "${f%%:*} is not the registered script (REGISTERED.txt scripts line)"; done
NAMES=$(cut -d'|' -f1 $IO/jobs_train.txt | tr '\n' ' ')
ledger_row(){ grep -E '^\| 9 \|' "$LEDGER" 2>/dev/null | grep -qF "$REG_MD5" || no "the ledger $LEDGER holds no '| 9 |' row with REGISTERED.txt $REG_MD5 (procedure step 2 first)"; }
rep_regs(){ # REPS = 'R:n1,n2 ...' of the registered repairs (REPAIR.md5 = md5 of REPAIR.txt and that md5 in the ledger)
  local d r m; REPS=""
  for d in $IO/repair[1-9]; do [ -e $d ] || continue; r=${d##*repair}; m=$(md5sum < $d/REPAIR.txt 2>/dev/null | cut -c1-32)
    [ -s $d/REPAIR.txt ] && [ "$(cat $d/REPAIR.md5 2>/dev/null)" = "$m" ] && grep -q "^repair $r of REGISTERED $REG_MD5 " $d/REPAIR.txt || no "$d is not a complete repair record"
    grep -qF "$m" "$LEDGER" 2>/dev/null || no "repair $r (REPAIR.txt $m) is not in the ledger $LEDGER: not registered"
    REPS="$REPS$r:$(awk '/^names /{$1=""; print}' $d/REPAIR.txt | xargs | tr ' ' ',') "; done; }
need_k(){ [ "$K" = $KC ] || no "K must be the full commit $KC"; }
kb_check(){ local out d; out=$(R "cd $KB && echo \"rev \$(cat REVISION)\"; md5sum -c --quiet CODE.md5 > /dev/null 2>&1 && echo CODE_OK; echo \"$PINS\" | md5sum -c --quiet - > /dev/null 2>&1 && echo PINS_OK; (cd $F2B && md5sum -c --quiet CODE.md5 > /dev/null 2>&1) && echo F2B_OK; diff <(grep -v '  REVISION\$' $F2B/CODE.md5) <(grep -v '  REVISION\$' CODE.md5) | grep '^[<>]' | awk '{print \$1 \$3}' | LC_ALL=C sort | tr '\n' ' '") || no "ssh failed"
  case "$out" in "rev $KC"*) ;; *) no "KB $KB REVISION is not K";; esac
  case "$out" in *CODE_OK*) ;; *) no "KB CODE.md5 check failed";; esac
  case "$out" in *PINS_OK*) ;; *) no "KB files do not match the pinned md5s";; esac
  case "$out" in *F2B_OK*) ;; *) no "F2B (deploy of F2) CODE.md5 check failed";; esac
  d=$(echo "$out" | tail -1); [ "$d" = "$DW" ] || no "KB differs from F2B in other paths than K's: $d"
  echo "KB $KB: REVISION K, CODE.md5 OK, pins OK; differs from F2B only in K's paths (+ REVISION)"; }
data_check(){ local o; o=$(R "md5sum < /tmp/noob_el/bench_data/DEPLOY.md5 | cut -c1-32") || no "ssh failed"; [ "$o" = $DATA_MD5 ] || no "bench_data DEPLOY.md5 is not $DATA_MD5"; }
dt_check(){ local o w; w="OK $(md5sum < $IO/data/MANIFEST.md5 | cut -c1-32) $(md5sum < $IO/data/roots/ROOTS_t3b.md5 | cut -c1-32) $(md5sum < $IO/data/LINKS.tsv | cut -c1-32)"
  o=$(R "cd $DT 2>/dev/null && md5sum -c --quiet MANIFEST.md5 > /dev/null 2>&1 && (cd roots && md5sum -c --quiet ROOTS_t3b.md5 > /dev/null 2>&1) && echo \"OK \$(md5sum < MANIFEST.md5 | cut -c1-32) \$(md5sum < roots/ROOTS_t3b.md5 | cut -c1-32) \$(find . -type l -printf '%P\t%l\n' | LC_ALL=C sort | md5sum | cut -c1-32)\"") || no "ssh failed"
  [ "$o" = "$w" ] || no "cv02 $DT: manifests, roots or links differ from IO/data (want '$w', got '$o')"
  echo "DT $DT: MANIFEST.md5, ROOTS_t3b.md5 and the link list = IO/data (BUILD.txt)"; }
ds_check(){ local o; o=$(R "cd $DS 2>/dev/null && md5sum -c --quiet MANIFEST.md5 > /dev/null 2>&1 && echo \"OK \$(md5sum < MANIFEST.md5 | cut -c1-32) \$(find . -type f | wc -l) \$(find . \\( -name masks -o -name ignore -o -name 'masks_*' \\) | wc -l)\"") || no "ssh failed"
  [ "$o" = "OK $SMAN 108 0" ] || no "cv02 $DS: manifest check, md5 (want $SMAN), 108 files and no mask dir expected; got '$o'"
  echo "DS $DS: 107 files + MANIFEST.md5 ($SMAN), md5sum -c OK, no mask or ignore dir"; }
names_check(){ local hit n; cut -d'|' -f1 $IO/jobs_train.txt $IO/jobs_dump.txt > $IO/names.txt
  hit=$(R "for n in $(tr '\n' ' ' < $IO/names.txt); do ls -d /tmp/noob_el/bench_*/experiments/\$n /tmp/noob_el/bench_*/experiments/\$n.stdout /tmp/noob_el/bench_*/dumps/elbench1/*/\$n /tmp/noob_el/bench_*/runs/\$n $BQ/*/pids/\$n.gpu 2>/dev/null; done; true") || no "ssh failed"
  [ -z "$hit" ] || no "names already used on cv02: $(echo "$hit" | head -3 | tr '\n' ' ')"
  for n in $(cat $IO/names.txt); do ls -d /home/noob/work/bench_relay/*/$n /mnt/nas/noob_el_archive/bench_relay/*/$n 2>/dev/null; done > $IO/relay_hits.txt
  [ ! -s $IO/relay_hits.txt ] || no "names already in a relay dir: $(head -3 $IO/relay_hits.txt | tr '\n' ' ')"
  echo "names: 63, none in use on cv02 or in a relay dir"; }
sealed_file(){ for k in 0 1 2 3 4; do echo "e1t3b_f$k $OPENING"; done; echo "manifest $SMAN"; }
q1_done(){ local o QL="$Q1" RL="" x n l bad="" k ok
  rep_regs
  for x in $REPS; do QL="$QL $BQ/t3brep${x%%:*}"; RL="$RL $BQ/t3brep${x%%:*}/launch.log"; done
  o=$(R "for q in $QL; do echo \"Q \$q \$(cat \$q/launch.log 2>/dev/null | grep -c 'BENCH CV02 Q ALL DONE') \$(kill -0 \$(cat \$q/queue.pid 2>/dev/null) 2>/dev/null && echo alive || echo ended)\"; done
    for n in $NAMES; do echo \"N \$n \$(cat $Q1/launch.log 2>/dev/null | grep -c \"trained \$n rc=0 \") \$(cat $RL /dev/null 2>/dev/null | grep -c \"trained \$n rc=0 \") \$(test -s $KB/runs/\$n/RUN.md5 && echo R || echo -)\"; done
    echo \"D \$(cd $BQ 2>/dev/null && ls -d t3brep[1-9] 2>/dev/null | tr '\n' ' ')\"") || no "ssh failed"
  while read -r k q c st; do [ "$k" = Q ] || continue; [ "${c:-0}" -ge 1 ] && [ "$st" = ended ] || bad="$bad queue $q not ended (ALL DONE $c, $st);"; done <<< "$o"
  for d in $(echo "$o" | awk '$1 == "D" {$1=""; print}'); do case " $REPS" in *" ${d#t3brep}:"*) ;; *) bad="$bad unregistered repair queue $BQ/$d;";; esac; done
  k=0; ok=0
  while read -r x n a b r; do [ "$x" = N ] || continue; k=$((k+1))
    if [ "$r" = R ] && { [ "${a:-0}" -ge 1 ] || { [ "${b:-0}" -ge 1 ] && echo " $REPS" | grep -qE "[:,]$n( |,)"; }; }; then ok=$((ok+1)); else bad="$bad $n (t3b $a, repair $b, RUN.md5 $r);"; fi
  done <<< "$o"
  [ $k = 33 ] || bad="$bad $k names reported;"
  grep -q "RELAY ALL DONE: 33 of 33" $RD1/relay.log 2>/dev/null || bad="$bad no 'RELAY ALL DONE: 33 of 33' in $RD1/relay.log;"
  for n in t3b_deploy_s5 t3b_deploy_s6 t3b_deploy_s7; do
    [ -e $RD1/.ok/$n ] && (cd $RD1/$n 2>/dev/null && md5sum -c --quiet runs/$n/RUN.md5 > /dev/null 2>&1) || bad="$bad $n not relayed or md5sum -c failed;"
    (cd $RD1/$n 2>/dev/null && test -f experiments/$n/checkpoints/latest.pth && md5sum -c --quiet runs/$n/LATEST.md5 > /dev/null 2>&1) || bad="$bad $n latest.pth not relayed (t3b_relay.sh deploy);"
  done
  grep -q "DEPLOY LATEST DONE: 3 of 3" $RD1/relay.log 2>/dev/null || bad="$bad no 'DEPLOY LATEST DONE: 3 of 3';"
  [ -z "$bad" ] || no "t3b is not complete:$bad"
  echo "t3b complete: $ok of 33 trained rc=0 with RUN.md5 (registered repairs: ${REPS:-none}); queues ended; relay 33 of 33; the 3 deployable units and their latest.pth verified on gaint"; }
